# Supabase (shared Career Diya + CareerAsana project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# AI providers (server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODE=mock
AI_DEFAULT_MODEL=claude-haiku-4-5-20251001
# Task identification (packages/prompts/task-identification/v1.md) deliberately stays on
# its own var, not AI_DEFAULT_MODEL, so dev-testing quality there is never silently
# downgraded. Defaults to claude-opus-4-8 if unset.
AI_TASK_IDENTIFICATION_MODEL=claude-opus-4-8
# ADR-CAREERDIY-0015: measurement-only, default off. Logs the direction the free-tier
# enrichment model would have picked independently, never shown to the user.
CAREER_DIYA_SHADOW_DIRECTION=0

# CareerAsana access: preview bypasses entitlement checks for local/internal testing.
# Production should use "paid" and grant core.product_access after payment.
CAREERASANA_ACCESS_MODE=preview

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
APP_REGION=IN
APP_BASE_URL=http://localhost:3000
